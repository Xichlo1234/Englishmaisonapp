# ────────────────────────────────────────────────────────────────
# DANH SÁCH BIẾN MÔI TRƯỜNG — KHÔNG ghi giá trị thật vào file này.
# ────────────────────────────────────────────────────────────────

# ── Worker: biến thường (workers/wrangler.jsonc → "vars") ──
APP_ENV=development                 # development | staging | production
APP_ORIGIN=http://localhost:5173     # origin của webapp (phân tách bằng dấu phẩy nếu nhiều)
ACCESS_TOKEN_TTL_SECONDS=900         # access token 15 phút
REFRESH_TTL_WEB_DAYS=7
REFRESH_TTL_MOBILE_DAYS=30
PBKDF2_ITERATIONS=30000              # gói Free; tăng 100000 khi lên Workers Paid
MAX_UPLOAD_MB=5
FCM_PROJECT_ID=

# ── Worker: secrets (wrangler secret put <TÊN>; local: workers/.dev.vars) ──
JWT_SECRET=                          # chuỗi ngẫu nhiên ≥ 32 ký tự: openssl rand -hex 32
FCM_CLIENT_EMAIL=                    # từ service account Firebase
FCM_PRIVATE_KEY=

# ── CI / GitHub Secrets (deploy & sao lưu) ──
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Mobile (flutter build ... --dart-define=API_BASE_URL=...) ──
API_BASE_URL=https://app.example.vn/api/v1
