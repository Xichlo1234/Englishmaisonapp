{
  "name": "english-class-management",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:api": "pnpm --filter @ecm/workers dev",
    "dev:web": "pnpm --filter @ecm/web dev",
    "db:migrate:local": "pnpm --filter @ecm/workers db:migrate:local"
  }
}
